función local CreateNewClear()
	local COUNT_NEWINDEX = 0
	
	devolver {
		__newindex = función(self, índice, valor)
			Si COUNT_NEWINDEX >= HIDDEN_SETTINGS.CLEAR_AFTER entonces
				para clave, caché en pares(self) hacer
					Si typeof(cache) == "Instance" y no cache:IsDescendantOf(game) entonces
						rawset(self, key, nil)
					fin
				fin
				COUNT_NEWINDEX = 0
			fin
			
			COUNT_NEWINDEX += 1
			devolver rawset(self, índice, valor)
		fin
	}
fin

